// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL para producción (configura DATABASE_URL en .env).
  // Para desarrollo local sin Docker: ver README_CORREGIDO.md
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Usuario Principal ───
model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  password         String
  role             String   @default("cliente") // cliente, repartidor, admin, ingeniero
  telefono         String?
  initials         String?
  color            String?
  fotoUrl          String?
  bio              String?
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  repartidorProfile    RepartidorProfile?
  ordenes              OrdenServicio[]          @relation("OrdenCliente")
  ordenesCompra        OrdenCompra[]            @relation("OrdenCompraCliente")
  passwordResets       PasswordReset[]
  direcciones          DireccionCliente[]
  metodosPago          MetodoPago[]
  favoritosTiendas     FavoritoTienda[]
  favoritosProductos   FavoritoProducto[]
  resenasTiendas       ResenaTienda[]
  solicitudesEnvio     SolicitudEnvio[]
  notificacionesPush   NotificacionPush[]
  auditLogs            AuditLog[]
  comentarios          Comentario[]
  tiendasSeguidas      TiendaFollow[]
  productosLiked       ProductoLike[]
  carritos             CarritoItem[]
  usosCodigos          UsoCodigo[]
  mensajesEnviados     MensajeDirecto[]         @relation("MensajeEmisor")
  mensajesRecibidos    MensajeDirecto[]         @relation("MensajeReceptor")
  chatsRepartidor      ChatRepartidor[]
  vistasStories        StoryVista[]
  actividades          ActividadUsuario[]
  valoracionesProducto ValoracionProducto[]
  calificacionesDadas  CalificacionRepartidor[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Envíos / Servicios de Repartidor ───
model OrdenServicio {
  id              String    @id @default(cuid())
  clienteId       String
  repartidorId    String?
  tipo            String    @default("envio") // envio, compra
  estado          String    @default("pendiente") // pendiente, asignado, aceptado, recogido, entregado, incidencia, cancelado
  origen          String
  destino         String
  origenLat       Float     @default(0)
  origenLng       Float     @default(0)
  destinoLat      Float     @default(0)
  destinoLng      Float     @default(0)
  paquete         String?
  tamano          String?
  fragil          Boolean   @default(false)
  tiendaId        String?
  tiendaNombre    String?
  metodoPago      String    @default("efectivo")
  monto           Float     @default(0)
  ganancia        Float     @default(0)
  kmEstimados     Float     @default(0)
  tiempoEstimado  Int       @default(0)
  kmRecorridos    Float     @default(0)
  tiempoTotal     Int       @default(0)
  incidenciaTipo  String?
  incidenciaDesc  String?
  clienteNombre   String
  clienteTelefono String?
  aceptadoEn      DateTime?
  recogidoEn      DateTime?
  entregadoEn     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cliente        User                     @relation("OrdenCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  repartidor     RepartidorProfile?       @relation("OrdenRepartidor", fields: [repartidorId], references: [id], onDelete: SetNull)
  calificaciones CalificacionRepartidor[]
  chats          ChatRepartidor[]
  servicios      ServicioRepartidor[]

  @@index([repartidorId, createdAt])
  @@index([estado])
  @@index([clienteId])
}

// ─── Marketing Models ───
model Campana {
  id             String    @id @default(cuid())
  titulo         String
  tipo           String // push, email, sms
  segmento       String // todos, frecuentes, inactivos, nuevos, vip, personalizado
  contenido      String // JSON con titulo, cuerpo, boton, etc.
  estado         String    @default("borrador") // borrador, programada, enviada, fallida
  programadaPara DateTime?
  enviadaEn      DateTime?
  destinatarios  Int       @default(0)
  abiertos       Int       @default(0)
  clicks         Int       @default(0)
  creadoPor      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CodigoPromocional {
  id             String      @id @default(cuid())
  codigo         String      @unique
  tipoDescuento  String // porcentaje, monto
  valor          Float
  aplicableA     String // todos, primer_envio, envio_minimo
  montoMinimo    Float?
  maxUsos        Int         @default(0) // 0 = ilimitado
  usosActuales   Int         @default(0)
  segmento       String      @default("todos")
  vigenciaInicio DateTime
  vigenciaFin    DateTime
  estado         String      @default("activo")
  creadoPor      String
  createdAt      DateTime    @default(now())
  usos           UsoCodigo[]
}

model UsoCodigo {
  id        String   @id @default(cuid())
  codigoId  String
  clienteId String
  ordenId   String?
  descuento Float
  usadoEn   DateTime @default(now())

  codigo  CodigoPromocional @relation(fields: [codigoId], references: [id], onDelete: Cascade)
  cliente User              @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([codigoId])
  @@index([clienteId])
}

model Banner {
  id              String    @id @default(cuid())
  titulo          String
  subtitulo       String?
  tipo            String // promo_grande, tarjeta_compacta, slider, notificacion
  colorFondo      String    @default("#FF5722")
  gradiente       String? // JSON {from, to, direction}
  colorTexto      String    @default("#FFFFFF")
  imagenUrl       String?
  botonTexto      String?
  botonAccion     String?
  botonLink       String?
  icono           String?
  segmento        String    @default("todos")
  mostrarEn       String    @default("app") // app, dashboard, ambos
  posicion        Int       @default(0)
  estado          String    @default("activo")
  impresiones     Int       @default(0)
  clicks          Int       @default(0)
  programadoDesde DateTime?
  programadoHasta DateTime?
  creadoPor       String
  createdAt       DateTime  @default(now())
}

model FeedItem {
  id          String   @id @default(cuid())
  tipo        String // anuncio, promocion, novedad, encuesta, recordatorio
  titulo      String
  descripcion String
  icono       String?
  botonTexto  String?
  botonLink   String?
  codigoPromo String?
  segmento    String   @default("todos")
  posicion    Int      @default(0)
  estado      String   @default("activo")
  impresiones Int      @default(0)
  clicks      Int      @default(0)
  creadoPor   String
  createdAt   DateTime @default(now())
}

model PlantillaMensaje {
  id        String   @id @default(cuid())
  nombre    String
  categoria String // orden, incidencia, promocion, general
  contenido String
  variables String // JSON array string
  esDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MensajeDirecto {
  id         String   @id @default(cuid())
  emisorId   String
  receptorId String
  contenido  String
  leido      Boolean  @default(false)
  enviadoEn  DateTime @default(now())

  emisor   User @relation("MensajeEmisor", fields: [emisorId], references: [id], onDelete: Cascade)
  receptor User @relation("MensajeReceptor", fields: [receptorId], references: [id], onDelete: Cascade)

  @@index([emisorId])
  @@index([receptorId])
}

model NotificacionAutomatica {
  id           String  @id @default(cuid())
  evento       String // orden_creada, orden_entregada, etc
  etiqueta     String
  activa       Boolean @default(true)
  canal        String // push, email, sms, todos
  plantilla    String
  destinatario String // cliente, repartidor, admin, ingeniero
}

// ─── Config Models ───
model ConfiguracionHorario {
  id              String  @id @default(cuid())
  dia             Int // 0-6 (domingo a sabado)
  horaInicio      String // "07:00"
  horaFin         String // "20:00"
  activo          Boolean @default(true)
  recargoNocturno Float   @default(0)
}

model Feriado {
  id      String   @id @default(cuid())
  fecha   DateTime
  nombre  String
  recargo Float    @default(0)
}

// ─── SuperAdmin Models ───
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  accion      String
  recurso     String
  recursoId   String?
  detalles    String?
  ip          String?
  dispositivo String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FeatureFlag {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String
  habilitado  Boolean @default(false)
}

// ─── Marketplace Models ───
model Tienda {
  id             String   @id @default(cuid())
  nombre         String
  descripcion    String?
  categoria      String // comida, tienda, farmacia, regalos, supermercado, tecnologia, deportes
  logoColor      String   @default("#FF5722")
  logoIniciales  String
  portadaColor   String   @default("#1B1B2F")
  imagenUrl      String? // logo o foto de la tienda
  bannerUrl      String? // imagen de portada
  direccion      String
  lat            Float
  lng            Float
  telefono       String?
  email          String?
  calificacion   Float    @default(0)
  totalPedidos   Int      @default(0)
  tiempoEstimado String   @default("25-35 min")
  costoEnvio     Float    @default(20)
  pedidoMinimo   Float    @default(50)
  horario        String // JSON
  zonaCobertura  String   @default("[]") // JSON array
  verificado     Boolean  @default(false)
  popular        Boolean  @default(false)
  estado         String   @default("activo")
  propietarioId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productos    Producto[]
  resenas      ResenaTienda[]
  favoritos    FavoritoTienda[]
  ordenes      OrdenCompra[]
  seguidores   TiendaFollow[]
  stories      Story[]
  carritosItem CarritoItem[]
}

model Producto {
  id              String   @id @default(cuid())
  tiendaId        String
  categoriaNombre String? // "Entradas", "Platos fuertes", etc.
  nombre          String
  descripcion     String?
  precio          Float
  precioOriginal  Float?
  imagenColor     String   @default("#E8E4DE")
  imagenUrl       String? // foto real del producto
  disponible      Boolean  @default(true)
  esNuevo         Boolean  @default(false)
  esPopular       Boolean  @default(false)
  stock           Int?
  posicion        Int      @default(0)
  createdAt       DateTime @default(now())

  tienda       Tienda               @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  favoritos    FavoritoProducto[]
  itemsOrden   ItemOrdenCompra[]
  carritoItems CarritoItem[]
  likes        ProductoLike[]
  valoraciones ValoracionProducto[]

  @@index([tiendaId])
}

model OrdenCompra {
  id               String    @id @default(cuid())
  clienteId        String
  tiendaId         String
  repartidorId     String?
  estado           String    @default("recibido") // recibido, preparando, listo, en_camino, entregado, cancelado
  direccionEntrega String
  lat              Float     @default(0)
  lng              Float     @default(0)
  instrucciones    String?
  metodoPago       String    @default("efectivo")
  subtotal         Float
  costoEnvio       Float
  descuento        Float     @default(0)
  codigoUsado      String?
  total            Float
  programadoPara   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cliente User              @relation("OrdenCompraCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  tienda  Tienda            @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  items   ItemOrdenCompra[]
  resenas ResenaTienda[]

  @@index([clienteId])
  @@index([tiendaId])
}

model ItemOrdenCompra {
  id             String @id @default(cuid())
  ordenId        String
  productoId     String
  nombreProducto String
  cantidad       Int
  precioUnitario Float
  variante       String?
  notas          String?

  orden    OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@index([productoId])
}

model FavoritoTienda {
  id        String   @id @default(cuid())
  clienteId String
  tiendaId  String
  createdAt DateTime @default(now())

  cliente User   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tienda  Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, tiendaId])
}

model FavoritoProducto {
  id         String   @id @default(cuid())
  clienteId  String
  productoId String
  createdAt  DateTime @default(now())

  cliente  User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, productoId])
}

model ResenaTienda {
  id         String   @id @default(cuid())
  tiendaId   String
  clienteId  String
  ordenId    String?
  estrellas  Int
  comentario String?
  createdAt  DateTime @default(now())

  cliente User         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tienda  Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  orden   OrdenCompra? @relation(fields: [ordenId], references: [id], onDelete: SetNull)

  @@index([tiendaId])
  @@index([clienteId])
}

// ─── Repartidor Models ───
model RepartidorProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  nombre           String
  email            String
  telefono         String?
  motoId           String?
  conectado        Boolean   @default(false)
  enServicio       Boolean   @default(false)
  pausado          Boolean   @default(false)
  pausaHasta       DateTime?
  lat              Float?
  lng              Float?
  zonaPreferida    String?
  calificacion     Float     @default(0)
  totalEntregas    Int       @default(0)
  totalKm          Float     @default(0)
  totalGanancias   Float     @default(0)
  tiempoPromedio   Int       @default(0)
  sonidoActivo     Boolean   @default(true)
  vibracionActiva  Boolean   @default(true)
  ubicacionActiva  Boolean   @default(true)
  rechazosHora     Int       @default(0)
  saldo            Float     @default(0)
  contratoAceptado Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moto             Moto?                    @relation(fields: [motoId], references: [id], onDelete: SetNull)
  ordenes          OrdenServicio[]          @relation("OrdenRepartidor")
  posiciones       PosicionRepartidor[]
  servicios        ServicioRepartidor[]
  notificaciones   NotificacionRepartidor[]
  chats            ChatRepartidor[]
  recargas         RecargaSaldo[]
  solicitudesEnvio SolicitudEnvio[]
}

model PosicionRepartidor {
  id           String   @id @default(cuid())
  repartidorId String
  lat          Float
  lng          Float
  velocidad    Float    @default(0)
  heading      Float    @default(0)
  timestamp    DateTime @default(now())

  repartidor RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  @@index([repartidorId, timestamp])
}

model ServicioRepartidor {
  id             String    @id @default(cuid())
  repartidorId   String
  ordenId        String
  tipo           String // envio, compra
  estado         String // asignado, aceptado, recogido, entregado, incidencia, cancelado
  kmRecorridos   Float     @default(0)
  kmEstimados    Float     @default(0)
  tiempoTotal    Int       @default(0)
  ganancia       Float     @default(0)
  incidenciaTipo String?
  incidenciaDesc String?
  aceptadoEn     DateTime?
  recogidoEn     DateTime?
  entregadoEn    DateTime?
  createdAt      DateTime  @default(now())

  repartidor RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)
  orden      OrdenServicio     @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([repartidorId, createdAt])
  @@index([estado])
}

model CalificacionRepartidor {
  id           String   @id @default(cuid())
  repartidorId String
  clienteId    String
  servicioId   String?
  ordenId      String
  estrellas    Int
  etiquetas    String   @default("[]") // JSON array string
  comentario   String?
  createdAt    DateTime @default(now())

  orden   OrdenServicio? @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  cliente User           @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([repartidorId, createdAt])
  @@index([clienteId])
}

model MotoAsignada {
  id                      String    @id @default(cuid())
  repartidorId            String    @unique
  nombre                  String
  modelo                  String
  placa                   String
  kmAcumulados            Float     @default(0)
  estado                  String    @default("DISPONIBLE") // DISPONIBLE, EN_SERVICIO, MANTENIMIENTO
  ultimoMantenimiento     DateTime?
  tipoUltimoMantenimiento String?
  proximoMantenimientoKm  Float?
  alertaMantenimiento     Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model NotificacionRepartidor {
  id           String   @id @default(cuid())
  repartidorId String
  tipo         String // orden_asignada, mensaje, entrega_calificada, incidencia, cancelacion, reasignacion
  titulo       String
  contenido    String
  leido        Boolean  @default(false)
  ordenId      String?
  createdAt    DateTime @default(now())

  repartidor RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  @@index([repartidorId, createdAt])
}

model ChatRepartidor {
  id           String   @id @default(cuid())
  ordenId      String
  repartidorId String
  clienteId    String
  emisor       String // repartidor, cliente
  contenido    String
  leido        Boolean  @default(false)
  enviadoEn    DateTime @default(now())

  orden      OrdenServicio?    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  repartidor RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)
  cliente    User              @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([ordenId, enviadoEn])
  @@index([repartidorId])
  @@index([clienteId])
}

model Moto {
  id               String    @id @default(cuid())
  nombre           String // "Moto-01", "Moto-02", etc.
  modelo           String // "Honda Wave 110", "Yamaha YBR 125"
  placa            String?   @unique
  anio             Int?
  color            String?
  vin              String? // Numero de serie
  kmAcumulados     Float     @default(0)
  estado           String    @default("DISPONIBLE") // DISPONIBLE, EN_SERVICIO, EN_MANTENIMIENTO, FUERA_SERVICIO
  asignadaA        String? // repartidorId si esta asignada
  imagenUrl        String?
  fechaAdquisicion DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mantenimientos Mantenimiento[]
  alertas        AlertaMantenimiento[]
  repartidores   RepartidorProfile[]
}

model Mantenimiento {
  id             String    @id @default(cuid())
  motoId         String
  tipo           String // PREVENTIVO, CORRECTIVO, EMERGENCIA
  categoria      String // CAMBIO_ACEITE, FRENO, LLANTA, CADENA, ELECTRICO, MOTOR, SUSPENSION, GENERAL
  descripcion    String
  observaciones  String?
  kmAlMomento    Float
  costoManoObra  Float     @default(0)
  costoRepuestos Float     @default(0)
  costoTotal     Float     @default(0)
  estado         String    @default("PROGRAMADO") // PROGRAMADO, EN_PROCESO, COMPLETADO, CANCELADO
  prioridad      String    @default("NORMAL") // BAJA, NORMAL, ALTA, URGENTE
  programadoPara DateTime?
  iniciadoEn     DateTime?
  completadoEn   DateTime?
  tecnicoId      String? // quien lo hizo
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  moto            Moto            @relation(fields: [motoId], references: [id], onDelete: Cascade)
  repuestosUsados RepuestoUsado[]

  @@index([motoId])
}

model Repuesto {
  id             String   @id @default(cuid())
  nombre         String // "Filtro de aceite Honda Wave"
  categoria      String // ACEITE, FRENO, LLANTA, CADENA, ELECTRICO, MOTOR, OTRO
  sku            String?  @unique
  descripcion    String?
  precioUnitario Float
  stock          Int      @default(0)
  stockMinimo    Int      @default(5)
  unidad         String   @default("pza") // pza, litro, metro, juego
  compatibleCon  String   @default("[]") // JSON string of ["Honda Wave 110", "Yamaha YBR 125"]
  proveedor      String?
  ubicacion      String? // "Estante A-3", "Bodega 1"
  imagenUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  usadosEn RepuestoUsado[]
}

model RepuestoUsado {
  id              String @id @default(cuid())
  mantenimientoId String
  repuestoId      String
  cantidad        Int
  precioUnitario  Float
  subtotal        Float

  mantenimiento Mantenimiento @relation(fields: [mantenimientoId], references: [id], onDelete: Cascade)
  repuesto      Repuesto      @relation(fields: [repuestoId], references: [id], onDelete: Cascade)

  @@index([mantenimientoId])
  @@index([repuestoId])
}

model AlertaMantenimiento {
  id           String    @id @default(cuid())
  motoId       String
  tipo         String // KM, FECHA, AMBOS
  descripcion  String
  kmTrigger    Float? // alertar cuando la moto llegue a X km
  fechaTrigger DateTime? // alertar en esta fecha
  activa       Boolean   @default(true)
  resuelta     Boolean   @default(false)
  resueltaEn   DateTime?
  createdAt    DateTime  @default(now())

  moto Moto @relation(fields: [motoId], references: [id], onDelete: Cascade)

  @@index([motoId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String // nombre final en disco
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  url          String // ruta pública /uploads/xxx.jpg
  uploaderId   String?
  categoria    String   @default("general") // perfil, producto, tienda, mantenimiento, banner, repuesto
  entidadId    String? // ID de la entidad relacionada (productoId, tiendaId, etc.)
  createdAt    DateTime @default(now())

  @@index([categoria, entidadId])
  @@index([uploaderId])
}

model TiendaFollow {
  id        String   @id @default(cuid())
  clienteId String
  tiendaId  String
  createdAt DateTime @default(now())

  cliente User   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tienda  Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, tiendaId])
  @@index([tiendaId])
  @@index([clienteId])
}

model ProductoLike {
  id         String   @id @default(cuid())
  clienteId  String
  productoId String
  createdAt  DateTime @default(now())

  cliente  User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, productoId])
  @@index([productoId])
  @@index([clienteId])
}

model Comentario {
  id            String   @id @default(cuid())
  entidad       String // producto, tienda, orden
  entidadId     String
  autorId       String
  autorNombre   String
  autorInitials String
  autorColor    String   @default("#FF5722")
  contenido     String
  padreId       String? // para respuestas
  likes         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  autor User @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([entidad, entidadId, createdAt])
  @@index([autorId])
}

model DireccionCliente {
  id             String   @id @default(cuid())
  clienteId      String
  etiqueta       String   @default("Casa") // Casa, Trabajo, Otro
  direccion      String
  lat            Float    @default(0)
  lng            Float    @default(0)
  referencia     String? // "Portón negro, casa esquinera"
  predeterminada Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cliente User @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model MetodoPago {
  id             String   @id @default(cuid())
  clienteId      String
  tipo           String // tarjeta, efectivo, transferencia
  titular        String?
  ultimos4       String? // "4242"
  marca          String? // Visa, Mastercard
  vencimiento    String? // "12/26"
  predeterminado Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cliente User @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model RecargaSaldo {
  id           String   @id @default(cuid())
  repartidorId String
  monto        Float
  metodo       String // codigo, transferencia, efectivo
  codigo       String?
  estado       String @default("completada") // pendiente, completada, fallida
  referencia   String?
  createdAt    DateTime @default(now())

  repartidor RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  @@index([repartidorId, createdAt])
}

model Story {
  id          String   @id @default(cuid())
  tipo        String // promo, novedad, tienda
  titulo      String
  descripcion String?
  imagenUrl   String?
  colorFondo  String   @default("#FF5722")
  link        String?
  tiendaId    String?
  segmento    String   @default("todos")
  activo      Boolean  @default(true)
  vistas      Int      @default(0)
  createdAt   DateTime @default(now())
  expiraEn    DateTime // 24h por defecto

  tienda Tienda?      @relation(fields: [tiendaId], references: [id], onDelete: SetNull)
  vistasRel StoryVista[]

  @@index([activo, expiraEn])
  @@index([tiendaId])
}

model StoryVista {
  id        String   @id @default(cuid())
  storyId   String
  clienteId String
  createdAt DateTime @default(now())

  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  cliente User  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([storyId, clienteId])
}

model DireccionBusqueda {
  id        String   @id @default(cuid())
  query     String
  resultados String // JSON
  createdAt DateTime @default(now())

  @@index([query])
}

model ActividadUsuario {
  id          String   @id @default(cuid())
  userId      String
  tipo        String // orden_creada, orden_entregada, producto_like, comentario, follow
  descripcion String
  entidadTipo String?
  entidadId   String?
  metadata    String? // JSON
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tipo])
}

model ValoracionProducto {
  id         String   @id @default(cuid())
  productoId String
  clienteId  String
  ordenId    String?
  estrellas  Int
  comentario String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  cliente  User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([productoId, clienteId])
  @@index([productoId])
  @@index([clienteId])
}

model SolicitudEnvio {
  id           String   @id @default(cuid())
  clienteId    String
  estado       String   @default("pendiente") // pendiente, aceptada, en_camino, entregado, cancelado
  origen       String
  destino      String
  origenLat    Float    @default(0)
  origenLng    Float    @default(0)
  destinoLat   Float    @default(0)
  destinoLng   Float    @default(0)
  paquete      String?
  tamano       String? // pequeño, mediano, grande
  fragil       Boolean  @default(false)
  metodoPago   String   @default("efectivo")
  monto        Float    @default(0)
  notas        String?
  repartidorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cliente    User               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  repartidor RepartidorProfile? @relation(fields: [repartidorId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([repartidorId])
  @@index([estado])
}

model ZonaCobertura {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  lat         Float    @default(0)
  lng         Float    @default(0)
  radio       Float    @default(5) // km
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model NotificacionPush {
  id        String   @id @default(cuid())
  userId    String
  titulo    String
  contenido String
  tipo      String // orden, promo, sistema, chat
  entidadId String?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leida, createdAt])
}

model CarritoItem {
  id         String   @id @default(cuid())
  clienteId  String
  productoId String
  tiendaId   String
  cantidad   Int      @default(1)
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cliente  User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tienda   Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, productoId])
  @@index([clienteId])
  @@index([tiendaId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LoginAudit {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
