generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                   @id @default(cuid())
  email                String                   @unique
  name                 String
  password             String
  role                 String                   @default("cliente")
  telefono             String?
  initials             String?
  color                String?
  fotoUrl              String?
  bio                  String?
  emailVerified        Boolean                  @default(false)
  twoFactorEnabled     Boolean                  @default(false)
  twoFactorSecret      String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  cedula               String?
  municipio            String?
  departamento         String?
  direccion            String?
  lat                  Float?                   @default(0)
  lng                  Float?                   @default(0)
  actividades          ActividadUsuario[]

  auditLogs            AuditLog[]
  calificacionesDadas  CalificacionRepartidor[]
  carritos             CarritoItem[]
  chatsRepartidor      ChatRepartidor[]
  comentarios          Comentario[]
  direcciones          DireccionCliente[]
  favoritosProductos   FavoritoProducto[]
  favoritosTiendas     FavoritoTienda[]
  mensajesEnviados     MensajeDirecto[]         @relation("MensajeEmisor")
  mensajesRecibidos    MensajeDirecto[]         @relation("MensajeReceptor")
  metodosPago          MetodoPago[]
  notificacionesPush   NotificacionPush[]
  ordenesCompra        OrdenCompra[]            @relation("OrdenCompraCliente")
  ordenes              OrdenServicio[]          @relation("OrdenCliente")
  passwordResets       PasswordReset[]
  productosLiked       ProductoLike[]
  repartidorProfile    RepartidorProfile?
  resenasTiendas       ResenaTienda[]
  solicitudesEnvio     SolicitudEnvio[]
  vistasStories        StoryVista[]
  tiendasSeguidas      TiendaFollow[]
  usosCodigos          UsoCodigo[]
  valoracionesProducto ValoracionProducto[]
  tiendasPropias       Tienda[]                 @relation("TiendaPropietario")
  posts                Post[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

model OrdenServicio {
  id              String                   @id @default(cuid())
  clienteId       String
  repartidorId    String?
  tipo            String                   @default("envio")
  estado          String                   @default("pendiente")
  origen          String
  destino         String
  origenLat       Float                    @default(0)
  origenLng       Float                    @default(0)
  destinoLat      Float                    @default(0)
  destinoLng      Float                    @default(0)
  paquete         String?
  tamano          String?
  fragil          Boolean                  @default(false)
  tiendaId        String?
  tiendaNombre    String?
  metodoPago      String                   @default("efectivo")
  monto           Float                    @default(0)
  ganancia        Float                    @default(0)
  kmEstimados     Float                    @default(0)
  tiempoEstimado  Int                      @default(0)
  kmRecorridos    Float                    @default(0)
  tiempoTotal     Int                      @default(0)
  incidenciaTipo  String?
  incidenciaDesc  String?
  clienteNombre   String
  clienteTelefono String?
  aceptadoEn      DateTime?
  recogidoEn      DateTime?
  entregadoEn     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  calificaciones  CalificacionRepartidor[]
  chats           ChatRepartidor[]
  cliente         User                     @relation("OrdenCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  repartidor      RepartidorProfile?       @relation("OrdenRepartidor", fields: [repartidorId], references: [id])
  servicios       ServicioRepartidor[]

  @@index([repartidorId, createdAt])
  @@index([estado])
  @@index([clienteId])
}

model Campana {
  id             String    @id @default(cuid())
  titulo         String
  tipo           String
  segmento       String
  contenido      String
  estado         String    @default("borrador")
  programadaPara DateTime?
  enviadaEn      DateTime?
  destinatarios  Int       @default(0)
  abiertos       Int       @default(0)
  clicks         Int       @default(0)
  creadoPor      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CodigoPromocional {
  id             String      @id @default(cuid())
  codigo         String      @unique
  tipoDescuento  String
  valor          Float
  aplicableA     String
  montoMinimo    Float?
  maxUsos        Int         @default(0)
  usosActuales   Int         @default(0)
  segmento       String      @default("todos")
  vigenciaInicio DateTime
  vigenciaFin    DateTime
  estado         String      @default("activo")
  creadoPor      String
  createdAt      DateTime    @default(now())
  usos           UsoCodigo[]
}

model UsoCodigo {
  id        String            @id @default(cuid())
  codigoId  String
  clienteId String
  ordenId   String?
  descuento Float
  usadoEn   DateTime          @default(now())
  cliente   User              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  codigo    CodigoPromocional @relation(fields: [codigoId], references: [id], onDelete: Cascade)

  @@index([codigoId])
  @@index([clienteId])
}

model Banner {
  id              String    @id @default(cuid())
  titulo          String
  subtitulo       String?
  tipo            String
  colorFondo      String    @default("#FF5722")
  gradiente       String?
  colorTexto      String    @default("#FFFFFF")
  imagenUrl       String?
  botonTexto      String?
  botonAccion     String?
  botonLink       String?
  icono           String?
  segmento        String    @default("todos")
  mostrarEn       String    @default("app")
  posicion        Int       @default(0)
  estado          String    @default("activo")
  impresiones     Int       @default(0)
  clicks          Int       @default(0)
  programadoDesde DateTime?
  programadoHasta DateTime?
  creadoPor       String
  createdAt       DateTime  @default(now())
}

model FeedItem {
  id          String   @id @default(cuid())
  tipo        String
  titulo      String
  descripcion String
  icono       String?
  botonTexto  String?
  botonLink   String?
  codigoPromo String?
  segmento    String   @default("todos")
  posicion    Int      @default(0)
  estado      String   @default("activo")
  impresiones Int      @default(0)
  clicks      Int      @default(0)
  creadoPor   String
  createdAt   DateTime @default(now())
}

model PlantillaMensaje {
  id        String   @id @default(cuid())
  nombre    String
  categoria String
  contenido String
  variables String
  esDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MensajeDirecto {
  id         String   @id @default(cuid())
  emisorId   String
  receptorId String
  contenido  String
  leido      Boolean  @default(false)
  enviadoEn  DateTime @default(now())
  emisor     User     @relation("MensajeEmisor", fields: [emisorId], references: [id], onDelete: Cascade)
  receptor   User     @relation("MensajeReceptor", fields: [receptorId], references: [id], onDelete: Cascade)

  @@index([emisorId])
  @@index([receptorId])
}

model NotificacionAutomatica {
  id           String  @id @default(cuid())
  evento       String
  etiqueta     String
  activa       Boolean @default(true)
  canal        String
  plantilla    String
  destinatario String
}

model ConfiguracionHorario {
  id              String  @id @default(cuid())
  dia             Int
  horaInicio      String
  horaFin         String
  activo          Boolean @default(true)
  recargoNocturno Float   @default(0)
}

model Feriado {
  id      String   @id @default(cuid())
  fecha   DateTime
  nombre  String
  recargo Float    @default(0)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  accion      String
  recurso     String
  recursoId   String?
  detalles    String?
  ip          String?
  dispositivo String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FeatureFlag {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String
  habilitado  Boolean @default(false)
}

model Tienda {
  id             String           @id @default(cuid())
  nombre         String
  descripcion    String?
  categoria      String
  logoColor      String           @default("#FF5722")
  logoIniciales  String
  portadaColor   String           @default("#1B1B2F")
  imagenUrl      String?
  bannerUrl      String?
  direccion      String
  lat            Float
  lng            Float
  telefono       String?
  email          String?
  calificacion   Float            @default(0)
  totalPedidos   Int              @default(0)
  tiempoEstimado String           @default("25-35 min")
  costoEnvio     Float            @default(20)
  pedidoMinimo   Float            @default(50)
  horario        String
  zonaCobertura  String           @default("[]")
  verificado     Boolean          @default(false)
  popular        Boolean          @default(false)
  estado         String           @default("activo")
  propietarioId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ruc            String?
  whatsapp       String?
  propietario    User?            @relation("TiendaPropietario", fields: [propietarioId], references: [id], onDelete: SetNull)
  carritosItem   CarritoItem[]
  favoritos      FavoritoTienda[]
  ordenes        OrdenCompra[]
  productos      Producto[]
  resenas        ResenaTienda[]
  stories        Story[]
  seguidores     TiendaFollow[]

  @@index([propietarioId])
}

model Producto {
  id              String               @id @default(cuid())
  tiendaId        String
  categoriaNombre String?
  nombre          String
  descripcion     String?
  precio          Float
  precioOriginal  Float?
  imagenColor     String               @default("#E8E4DE")
  imagenUrl       String?
  disponible      Boolean              @default(true)
  esNuevo         Boolean              @default(false)
  esPopular       Boolean              @default(false)
  stock           Int?
  posicion        Int                  @default(0)
  createdAt       DateTime             @default(now())
  carritoItems    CarritoItem[]
  favoritos       FavoritoProducto[]
  itemsOrden      ItemOrdenCompra[]
  tienda          Tienda               @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  likes           ProductoLike[]
  valoraciones    ValoracionProducto[]

  @@index([tiendaId])
}

model OrdenCompra {
  id               String            @id @default(cuid())
  clienteId        String
  tiendaId         String
  repartidorId     String?
  estado           String            @default("recibido")
  direccionEntrega String
  lat              Float             @default(0)
  lng              Float             @default(0)
  instrucciones    String?
  metodoPago       String            @default("efectivo")
  subtotal         Float
  costoEnvio       Float
  descuento        Float             @default(0)
  codigoUsado      String?
  total            Float
  programadoPara   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            ItemOrdenCompra[]
  cliente          User              @relation("OrdenCompraCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  tienda           Tienda            @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  repartidor       RepartidorProfile? @relation("OrdenCompraRepartidor", fields: [repartidorId], references: [id], onDelete: SetNull)
  resenas          ResenaTienda[]

  @@index([clienteId])
  @@index([tiendaId])
  @@index([repartidorId])
}

model ItemOrdenCompra {
  id             String      @id @default(cuid())
  ordenId        String
  productoId     String
  nombreProducto String
  cantidad       Int
  precioUnitario Float
  variante       String?
  notas          String?
  orden          OrdenCompra @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  producto       Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([ordenId])
  @@index([productoId])
}

model FavoritoTienda {
  id        String   @id @default(cuid())
  clienteId String
  tiendaId  String
  createdAt DateTime @default(now())
  cliente   User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, tiendaId])
}

model FavoritoProducto {
  id         String   @id @default(cuid())
  clienteId  String
  productoId String
  createdAt  DateTime @default(now())
  cliente    User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, productoId])
}

model ResenaTienda {
  id         String       @id @default(cuid())
  tiendaId   String
  clienteId  String
  ordenId    String?
  estrellas  Int
  comentario String?
  createdAt  DateTime     @default(now())
  cliente    User         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  orden      OrdenCompra? @relation(fields: [ordenId], references: [id])
  tienda     Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId])
  @@index([clienteId])
}

model RepartidorProfile {
  id               String                   @id @default(cuid())
  userId           String                   @unique
  nombre           String
  email            String
  telefono         String?
  motoId           String?
  conectado        Boolean                  @default(false)
  enServicio       Boolean                  @default(false)
  pausado          Boolean                  @default(false)
  pausaHasta       DateTime?
  lat              Float?
  lng              Float?
  zonaPreferida    String?
  calificacion     Float                    @default(0)
  totalEntregas    Int                      @default(0)
  totalKm          Float                    @default(0)
  totalGanancias   Float                    @default(0)
  tiempoPromedio   Int                      @default(0)
  sonidoActivo     Boolean                  @default(true)
  vibracionActiva  Boolean                  @default(true)
  ubicacionActiva  Boolean                  @default(true)
  rechazosHora     Int                      @default(0)
  saldo            Float                    @default(0)
  contratoAceptado Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  vehiculoTipo     String?
  vehiculoMarca    String?
  vehiculoModelo   String?
  vehiculoAnio     Int?
  vehiculoColor    String?
  vehiculoPlaca    String?
  cedulaRepartidor String?
  chats            ChatRepartidor[]
  notificaciones   NotificacionRepartidor[]
  ordenes          OrdenServicio[]          @relation("OrdenRepartidor")
  ordenesCompra    OrdenCompra[]            @relation("OrdenCompraRepartidor")
  posiciones       PosicionRepartidor[]
  recargas         RecargaSaldo[]
  motoAsignada     MotoAsignada?
  moto             Moto?                    @relation(fields: [motoId], references: [id])
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  servicios        ServicioRepartidor[]
  solicitudesEnvio SolicitudEnvio[]
}

model PosicionRepartidor {
  id           String            @id @default(cuid())
  repartidorId String
  lat          Float
  lng          Float
  velocidad    Float             @default(0)
  heading      Float             @default(0)
  timestamp    DateTime          @default(now())
  repartidor   RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  @@index([repartidorId, timestamp])
}

model ServicioRepartidor {
  id             String            @id @default(cuid())
  repartidorId   String
  ordenId        String
  tipo           String
  estado         String
  kmRecorridos   Float             @default(0)
  kmEstimados    Float             @default(0)
  tiempoTotal    Int               @default(0)
  ganancia       Float             @default(0)
  incidenciaTipo String?
  incidenciaDesc String?
  aceptadoEn     DateTime?
  recogidoEn     DateTime?
  entregadoEn    DateTime?
  createdAt      DateTime          @default(now())
  orden          OrdenServicio     @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  repartidor     RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  @@index([repartidorId, createdAt])
  @@index([estado])
}

model CalificacionRepartidor {
  id           String        @id @default(cuid())
  repartidorId String
  clienteId    String
  servicioId   String?
  ordenId      String
  estrellas    Int
  etiquetas    String        @default("[]")
  comentario   String?
  createdAt    DateTime      @default(now())
  cliente      User          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  orden        OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([repartidorId, createdAt])
  @@index([clienteId])
}

model MotoAsignada {
  id                      String            @id @default(cuid())
  repartidorId            String            @unique
  nombre                  String
  modelo                  String
  placa                   String
  kmAcumulados            Float             @default(0)
  estado                  String            @default("DISPONIBLE")
  ultimoMantenimiento     DateTime?
  tipoUltimoMantenimiento String?
  proximoMantenimientoKm  Float?
  alertaMantenimiento     Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  repartidor              RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)
}

model NotificacionRepartidor {
  id           String            @id @default(cuid())
  repartidorId String
  tipo         String
  titulo       String
  contenido    String
  leido        Boolean           @default(false)
  ordenId      String?
  createdAt    DateTime          @default(now())
  repartidor   RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  @@index([repartidorId, createdAt])
}

model ChatRepartidor {
  id           String            @id @default(cuid())
  ordenId      String
  repartidorId String
  clienteId    String
  emisor       String
  contenido    String
  leido        Boolean           @default(false)
  enviadoEn    DateTime          @default(now())
  cliente      User              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  orden        OrdenServicio     @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  repartidor   RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  @@index([ordenId, enviadoEn])
  @@index([repartidorId])
  @@index([clienteId])
}

model Moto {
  id               String                @id @default(cuid())
  nombre           String
  modelo           String
  placa            String?               @unique
  anio             Int?
  color            String?
  vin              String?
  kmAcumulados     Float                 @default(0)
  estado           String                @default("DISPONIBLE")
  asignadaA        String?
  imagenUrl        String?
  fechaAdquisicion DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  alertas          AlertaMantenimiento[]
  mantenimientos   Mantenimiento[]
  repartidores     RepartidorProfile[]
}

model Mantenimiento {
  id              String          @id @default(cuid())
  motoId          String
  tipo            String
  categoria       String
  descripcion     String
  observaciones   String?
  kmAlMomento     Float
  costoManoObra   Float           @default(0)
  costoRepuestos  Float           @default(0)
  costoTotal      Float           @default(0)
  estado          String          @default("PROGRAMADO")
  prioridad       String          @default("NORMAL")
  programadoPara  DateTime?
  iniciadoEn      DateTime?
  completadoEn    DateTime?
  tecnicoId       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  moto            Moto            @relation(fields: [motoId], references: [id], onDelete: Cascade)
  repuestosUsados RepuestoUsado[]

  @@index([motoId])
}

model Repuesto {
  id             String          @id @default(cuid())
  nombre         String
  categoria      String
  sku            String?         @unique
  descripcion    String?
  precioUnitario Float
  stock          Int             @default(0)
  stockMinimo    Int             @default(5)
  unidad         String          @default("pza")
  compatibleCon  String          @default("[]")
  proveedor      String?
  ubicacion      String?
  imagenUrl      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  usadosEn       RepuestoUsado[]
}

model RepuestoUsado {
  id              String        @id @default(cuid())
  mantenimientoId String
  repuestoId      String
  cantidad        Int
  precioUnitario  Float
  subtotal        Float
  mantenimiento   Mantenimiento @relation(fields: [mantenimientoId], references: [id], onDelete: Cascade)
  repuesto        Repuesto      @relation(fields: [repuestoId], references: [id], onDelete: Cascade)

  @@index([mantenimientoId])
  @@index([repuestoId])
}

model AlertaMantenimiento {
  id           String    @id @default(cuid())
  motoId       String
  tipo         String
  descripcion  String
  kmTrigger    Float?
  fechaTrigger DateTime?
  activa       Boolean   @default(true)
  resuelta     Boolean   @default(false)
  resueltaEn   DateTime?
  createdAt    DateTime  @default(now())
  moto         Moto      @relation(fields: [motoId], references: [id], onDelete: Cascade)

  @@index([motoId])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  url          String
  uploaderId   String?
  categoria    String   @default("general")
  entidadId    String?
  createdAt    DateTime @default(now())

  @@index([categoria, entidadId])
  @@index([uploaderId])
}

model TiendaFollow {
  id        String   @id @default(cuid())
  clienteId String
  tiendaId  String
  createdAt DateTime @default(now())
  cliente   User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, tiendaId])
  @@index([tiendaId])
  @@index([clienteId])
}

model ProductoLike {
  id         String   @id @default(cuid())
  clienteId  String
  productoId String
  createdAt  DateTime @default(now())
  cliente    User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, productoId])
  @@index([productoId])
  @@index([clienteId])
}

model Comentario {
  id            String   @id @default(cuid())
  entidad       String
  entidadId     String
  autorId       String
  autorNombre   String
  autorInitials String
  autorColor    String   @default("#FF5722")
  contenido     String
  padreId       String?
  likes         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  autor         User     @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([entidad, entidadId, createdAt])
  @@index([autorId])
}

model DireccionCliente {
  id             String   @id @default(cuid())
  clienteId      String
  etiqueta       String   @default("Casa")
  direccion      String
  lat            Float    @default(0)
  lng            Float    @default(0)
  referencia     String?
  predeterminada Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cliente        User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model MetodoPago {
  id             String   @id @default(cuid())
  clienteId      String
  tipo           String
  titular        String?
  ultimos4       String?
  marca          String?
  vencimiento    String?
  predeterminado Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cliente        User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model RecargaSaldo {
  id           String            @id @default(cuid())
  repartidorId String
  monto        Float
  metodo       String
  codigo       String?
  estado       String            @default("completada")
  referencia   String?
  createdAt    DateTime          @default(now())
  repartidor   RepartidorProfile @relation(fields: [repartidorId], references: [id], onDelete: Cascade)

  @@index([repartidorId, createdAt])
}

model Story {
  id          String       @id @default(cuid())
  tipo        String
  titulo      String
  descripcion String?
  imagenUrl   String?
  colorFondo  String       @default("#FF5722")
  link        String?
  tiendaId    String?
  segmento    String       @default("todos")
  activo      Boolean      @default(true)
  vistas      Int          @default(0)
  createdAt   DateTime     @default(now())
  expiraEn    DateTime
  tienda      Tienda?      @relation(fields: [tiendaId], references: [id])
  vistasRel   StoryVista[]

  @@index([activo, expiraEn])
  @@index([tiendaId])
}

model StoryVista {
  id        String   @id @default(cuid())
  storyId   String
  clienteId String
  createdAt DateTime @default(now())
  cliente   User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, clienteId])
}

model DireccionBusqueda {
  id         String   @id @default(cuid())
  query      String
  resultados String
  createdAt  DateTime @default(now())

  @@index([query])
}

model ActividadUsuario {
  id          String   @id @default(cuid())
  userId      String
  tipo        String
  descripcion String
  entidadTipo String?
  entidadId   String?
  metadata    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tipo])
}

model ValoracionProducto {
  id         String   @id @default(cuid())
  productoId String
  clienteId  String
  ordenId    String?
  estrellas  Int
  comentario String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cliente    User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([productoId, clienteId])
  @@index([productoId])
  @@index([clienteId])
}

model SolicitudEnvio {
  id           String             @id @default(cuid())
  clienteId    String
  estado       String             @default("pendiente")
  origen       String
  destino      String
  origenLat    Float              @default(0)
  origenLng    Float              @default(0)
  destinoLat   Float              @default(0)
  destinoLng   Float              @default(0)
  paquete      String?
  tamano       String?
  fragil       Boolean            @default(false)
  metodoPago   String             @default("efectivo")
  monto        Float              @default(0)
  notas        String?
  repartidorId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  cliente      User               @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  repartidor   RepartidorProfile? @relation(fields: [repartidorId], references: [id])

  @@index([clienteId])
  @@index([repartidorId])
  @@index([estado])
}

model ZonaCobertura {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  lat         Float    @default(0)
  lng         Float    @default(0)
  radio       Float    @default(5)
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model NotificacionPush {
  id        String   @id @default(cuid())
  userId    String
  titulo    String
  contenido String
  tipo      String
  entidadId String?
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leida, createdAt])
}

model CarritoItem {
  id         String   @id @default(cuid())
  clienteId  String
  productoId String
  tiendaId   String
  cantidad   Int      @default(1)
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cliente    User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tienda     Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([clienteId, productoId])
  @@index([clienteId])
  @@index([tiendaId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LoginAudit {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
