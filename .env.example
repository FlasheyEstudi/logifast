# ═══════════════════════════════════════════════════════
# LOGIFAST — Variables de entorno
# ═══════════════════════════════════════════════════════
# Copia este archivo a .env y completa los valores.

# Base de datos PostgreSQL (PRODUCCIÓN)
# Para desarrollo local sin Docker: ver instrucciones en README_CORREGIDO.md
DATABASE_URL="postgresql://logifast:logifast@localhost:5432/logifast?schema=public"

# JWT secret para firmar sesiones (MÍNIMO 32 caracteres, obligatorio en producción)
JWT_SECRET="logifast-dev-secret-cambiar-en-produccion-9f3a7c2e8b1d4f6a"

# Entorno
NODE_ENV="development"

# URL del servicio realtime (socket.io) — opcional
REALTIME_SERVICE_URL="http://localhost:3003"
NEXT_PUBLIC_WS_URL="http://localhost:3003"

# Puerto del servidor (default 3000)
PORT=3000

# Supabase Storage & Media
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-aqui"
